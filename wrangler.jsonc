// Configuración del Worker de VR Play en Cloudflare (se despliega solo con cada subida a main).
// - La web son los archivos de la raíz del repositorio (menos lo que excluye .assetsignore).
// - El programa de servidor/index.js solo se ejecuta para /api/* (el foro), las fichas de los juegos
//   (/juego/*), /sitemap.xml y /llms.txt.
// - Las claves (ADMIN_TOKEN, SAL, RESEND_API_KEY, GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET) NO van aquí:
//   se ponen como "Secret" en el panel de Cloudflare.
// - CUENTAS: "1" enseña a todo el mundo el botón «Entrar» de las cuentas de usuario. Con "0" solo se ve
//   abriendo la web con ?perfiles=1 (para probarlas antes de publicarlas).
{
  "name": "vr-play",
  "main": "servidor/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/juego/*", "/sitemap.xml", "/llms.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vrplay-foro",
      "database_id": "4f1328b4-ff9d-4bd9-a185-a0de54a4238c"
    }
  ],
  "vars": { "CUENTAS": "1" },
  "observability": { "enabled": true }
}
