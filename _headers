# Cabeceras de seguridad de la web (Cloudflare las añade a los archivos estáticos).
# xr-spatial-tracking (la VR) y gamepad (los mandos) no se limitan.
#
# Content-Security-Policy: lo que pueden cargar las páginas. Si una página nueva carga algo de otra web, añádelo aquí:
#   script-src   'unsafe-inline' porque las páginas llevan su código y el importmap dentro del HTML; three.js
#                (jsDelivr), la analítica de Cloudflare y el captcha (Turnstile)
#   connect-src  la API (misma web), three.js (también lo pide el service worker), la analítica y el captcha
#   frame-src    el captcha va en un iframe de Cloudflare
#   worker-src   el service worker (/sw.js)
#   frame-ancestors  la web se puede incrustar en itch.io (y en ella misma); en ninguna otra
# Las páginas de la cuenta, entrar, perfiles y administración no se pueden incrustar en ningún sitio (contra
# el «clickjacking»): llevan además frame-ancestors 'none' y X-Frame-Options (abajo). Cloudflare junta las
# dos Content-Security-Policy y el navegador aplica las dos.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' https://cdn.jsdelivr.net https://cloudflareinsights.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://itch.io https://*.itch.io https://*.itch.zone https://*.hwcdn.net

/admin*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
/cuenta*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
/entrar*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
/perfil*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# Las fuentes no cambian de nombre al actualizarse casi nunca: se guardan 30 días en la caché del navegador
/estilos/fuentes/*
  Cache-Control: public, max-age=2592000

# Miniaturas de los juegos e iconos: 3 días en la caché y, pasado ese tiempo, se sirven mientras se comprueba
# si han cambiado (así una miniatura nueva llega en pocos días sin cambiarle el nombre)
/juegos/*/miniatura.svg
  Cache-Control: public, max-age=259200, stale-while-revalidate=604800
/iconos/*
  Cache-Control: public, max-age=259200, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=259200, stale-while-revalidate=604800

# El service worker se comprueba siempre (si no, una versión nueva tardaría en llegar)
/sw.js
  Cache-Control: no-cache
